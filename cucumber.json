{
    "default": {
        "dryRun": false,
        "formatOptions": {
            "snippetInterface": "async-await"
        },
        "paths": [
            "e2etest/test/features/**/*.feature"
        ],
        "require": [
            "e2etest/test/steps/**/*.ts"
        ],
        "requireModule": [
            "ts-node/register"
        ],
        "format": 
        ["progress",
            "html:cucumber-report.html",
            "json:cucumber-report.json",
          "allure-cucumberjs/reporter"]
    }
}